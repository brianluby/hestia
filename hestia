#!/usr/bin/env bash
# ADR-006 step 2 — one thin launcher over the existing helpers.
#
# usage: hestia [<checkout-path>] [-- <agent args>...]
#
# Builds the default pi image if it is missing, writes the workspace's Compose
# file beside its state directory, starts the workspace (a no-op when it already
# runs) and opens pi in the checkout. Running it again re-attaches. Expert
# operations stay in workspace/workspace-lifecycle.sh against the file named on
# the "wrote <file>" line.
set -euo pipefail

# Follow symlinks so a `hestia` linked onto PATH still finds the install.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
	dir="$(cd -P "$(dirname "$src")" && pwd)"
	src="$(readlink "$src")"
	case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
here="$(cd -P "$(dirname "$src")" && pwd)"

image="hestia-pi:local"

fail() {
	echo "hestia: error: $*" >&2
	exit 1
}

checkout="."
if [ "$#" -gt 0 ] && [ "$1" != "--" ]; then
	checkout="$1"
	shift
fi
if [ "$#" -gt 0 ]; then
	[ "$1" = "--" ] || {
		echo "usage: hestia [<checkout-path>] [-- <agent args>...]" >&2
		exit 2
	}
	shift
fi

command -v docker >/dev/null 2>&1 || fail "docker is not installed — install Docker first"
docker info >/dev/null 2>&1 || fail "docker daemon is not reachable — start Docker and retry"

# Resolves the checkout root; its error (e.g. not a Git checkout) is shown as is.
ids="$("$here/identity/workspace-id.sh" "$checkout")"
canonical="$(printf '%s\n' "$ids" | sed -n 's/^canonical: //p')"
workspace_id="$(printf '%s\n' "$ids" | sed -n 's/^workspace: //p')"
# Beside, not inside, the state dir: that dir is mounted writable into the
# container, and an agent must not be able to edit the file the host runs.
compose="${HESTIA_STATE_ROOT:-$HOME/.local/share/hestia}/$workspace_id.compose.yaml"

if ! docker image inspect "$image" >/dev/null 2>&1; then
	echo "hestia: first run — building $image (this takes a few minutes)" >&2
	docker build --platform linux/arm64 --target pi -t "$image" "$here"
fi

# Launching trusts exactly this checkout's mise configuration, and pi's home is
# shared by every workspace so login happens once per user (ADR-006).
"$here/workspace/workspace-compose.sh" --image "$image" --shared-state pi \
	--env "MISE_TRUSTED_CONFIG_PATHS=$canonical" --out "$compose" "$canonical"
"$here/workspace/workspace-lifecycle.sh" start "$compose"
exec "$here/workspace/workspace-lifecycle.sh" attach "$compose" pi "$@"
