{
  "extends": "hestia-base",
  "meta": {
    "name": "hestia-claude",
    "description": "Claude Code in a Hestia workspace: its config dir and lock dir, Anthropic hosts only"
  },
  "filesystem": {
    "allow": ["$HOME/.claude", "$HOME/.claude.lock"]
  },
  "network": {
    "allow_domain": ["api.anthropic.com", "claude.ai", "platform.claude.com", "console.anthropic.com"]
  },
  "environment": {
    "set_vars": { "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1" }
  }
}
